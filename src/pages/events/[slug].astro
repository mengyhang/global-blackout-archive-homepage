---
import { blackoutEvents } from "../../data/blackouts";
import fs from "fs";
import path from "path";
import { marked } from "marked";

export function getStaticPaths() {
  return blackoutEvents.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

// 读取 Markdown 文件
let markdownContent = "";
const mdPath = path.join(process.cwd(), "docs", "events", `${event.slug}.md`);
const templatePath = path.join(process.cwd(), "docs", "events", "_template.md");

try {
  markdownContent = fs.readFileSync(mdPath, "utf-8");
} catch {
  try {
    markdownContent = fs.readFileSync(templatePath, "utf-8");
  } catch {
    markdownContent = "# 内容待补充\n\n请在 `docs/events/` 目录下创建对应的 Markdown 文件。";
  }
}

const htmlContent = marked(markdownContent);
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{event.nameCn} - Global Blackout Archive</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.6;
      color: #333;
      background: #fafafa;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    .back-link {
      display: inline-block;
      color: #666;
      text-decoration: none;
      margin-bottom: 30px;
      font-size: 14px;
    }
    .back-link:hover {
      color: #000;
    }
    .header {
      background: white;
      padding: 40px;
      border-left: 4px solid #333;
      border-radius: 8px;
      margin-bottom: 30px;
    }
    .year {
      font-size: 48px;
      font-weight: 300;
      color: #000;
      margin-bottom: 10px;
    }
    .title {
      font-size: 28px;
      font-weight: 500;
      color: #000;
      margin-bottom: 8px;
    }
    .subtitle {
      font-size: 16px;
      color: #666;
      margin-bottom: 20px;
    }
    .hook {
      font-size: 18px;
      font-style: italic;
      color: #555;
      border-left: 3px solid #ddd;
      padding-left: 20px;
    }
    .content {
      background: white;
      padding: 40px;
      border-radius: 8px;
    }
    .section {
      margin-bottom: 30px;
    }
    .section-title {
      font-size: 20px;
      font-weight: 600;
      color: #000;
      margin-bottom: 12px;
      border-bottom: 2px solid #eee;
      padding-bottom: 8px;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }
    .info-item {
      padding: 15px;
      background: #f9f9f9;
      border-left: 3px solid #ddd;
      border-radius: 6px;
    }
    .info-label {
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
      margin-bottom: 5px;
    }
    .info-value {
      font-size: 16px;
      color: #333;
      font-weight: 500;
    }
    .markdown-content {
      color: #333;
      line-height: 1.8;
    }
    .markdown-content h1 {
      font-size: 24px;
      font-weight: 600;
      margin: 20px 0 15px;
      color: #000;
    }
    .markdown-content h2 {
      font-size: 20px;
      font-weight: 600;
      margin: 18px 0 12px;
      color: #000;
      border-bottom: 1px solid #eee;
      padding-bottom: 6px;
    }
    .markdown-content h3 {
      font-size: 18px;
      font-weight: 600;
      margin: 16px 0 10px;
      color: #333;
    }
    .markdown-content p {
      margin-bottom: 15px;
    }
    .markdown-content ul, .markdown-content ol {
      margin: 15px 0;
      padding-left: 30px;
    }
    .markdown-content li {
      margin-bottom: 8px;
    }
    .markdown-content hr {
      border: none;
      border-top: 1px solid #ddd;
      margin: 25px 0;
    }
    .markdown-content code {
      background: #f5f5f5;
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 14px;
    }
    .markdown-content pre {
      background: #f5f5f5;
      padding: 15px;
      border-radius: 5px;
      overflow-x: auto;
      margin: 15px 0;
    }
    .markdown-content blockquote {
      border-left: 3px solid #ddd;
      padding-left: 20px;
      color: #666;
      margin: 15px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← 返回档案馆</a>

    <div class="header">
      <div class="year">{event.year}</div>
      <h1 class="title">{event.nameCn}</h1>
      <p class="subtitle">{event.name}</p>
      <p class="hook">"{event.hook}"</p>
    </div>

    <div class="content">
      <div class="section">
        <h2 class="section-title">基本信息</h2>
        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">日期</div>
            <div class="info-value">{event.date}</div>
          </div>
          <div class="info-item">
            <div class="info-label">地点</div>
            <div class="info-value">{event.location}</div>
          </div>
          <div class="info-item">
            <div class="info-label">影响范围</div>
            <div class="info-value">{event.affectedArea}</div>
          </div>
          <div class="info-item">
            <div class="info-label">受影响人数</div>
            <div class="info-value">{event.affectedPeople}</div>
          </div>
          <div class="info-item">
            <div class="info-label">持续时间</div>
            <div class="info-value">{event.duration}</div>
          </div>
          <div class="info-item">
            <div class="info-label">原因</div>
            <div class="info-value">{event.cause}</div>
          </div>
        </div>
      </div>

      <div class="section">
        <h2 class="section-title">事件详情</h2>
        <div class="markdown-content" set:html={htmlContent}></div>
      </div>
    </div>
  </div>
</body>
</html>
